{
  "name": "portfolio-modern",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "version": "2.0.0",
  "type": "module",

  "scripts": {
  "dev": "vite",
  "build": "tsc --noEmit && vite build",
  "preview": "vite preview",
  "lint": "oxlint",
  "typecheck": "tsc --noEmit",
  "certs": "python3 scripts/sync_certificates.py",
  "images": "python3 scripts/optimize_images.py --apply",
  "images:check": "python3 scripts/optimize_images.py --check",
  "audit": "python3 scripts/audit_build.py"
  },

  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "10.4.20",
    "oxlint": "^1.88.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
